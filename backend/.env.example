# Claude API key the gateway uses upstream. Employees never see it.
ANTHROPIC_API_KEY=
# DigitalOcean Serverless Inference key for Jev.
MODEL_ACCESS_KEY=
# One gateway credential per person or tool, as key:team pairs.
GATEWAY_KEYS=change-me-1:platform,change-me-2:support
# Unlocks the admin view.
ADMIN_TOKEN=change-me
# Share of cheaper answers to check against the requested model. 0 turns checks off.
SHADOW_RATE=0.03
# Quality checks stop for the day once they've cost this much.
SHADOW_DAILY_BUDGET_USD=25
