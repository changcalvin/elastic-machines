# Required. Claude API key the gateway uses upstream, and for the quality-check judge.
ANTHROPIC_API_KEY=
# Required for routing. DigitalOcean inference key for Jev, the router. Without it every
# request stays on the model that was asked for, so nothing is saved.
MODEL_ACCESS_KEY=
# Optional. Adds GPT models to the chat and the gateway.
OPENAI_API_KEY=
# Optional. Adds Gemini models to the chat and the gateway.
GEMINI_API_KEY=

# One gateway key per person or tool, as key:team pairs. The chat uses the first one.
GATEWAY_KEYS=change-me-1:platform,change-me-2:support
# Unlocks the /admin endpoints.
ADMIN_TOKEN=change-me

# Share of cheaper answers to check against the requested model. 0 turns checks off.
SHADOW_RATE=0.03
# Quality checks stop for the day once they've cost this much.
SHADOW_DAILY_BUDGET_USD=25
